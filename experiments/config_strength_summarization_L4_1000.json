{
  "dataset": "summarization",
  "samples": 1000,
  "lookahead": 4,
  "max_length": 128,
  "seed": 1,
  "private_key": "1234",
  "target_model": "model/Qwen2.5-7B-Instruct",
  "draft_model": "model/Qwen2.5-0.5B-Instruct",
  "target_device": "cuda:1",
  "draft_device": "cuda:1",
  "progress_every": 50,
  "output": "outputs/strength_summarization_L4_1000.json",
  "rows_output": "outputs/strength_summarization_L4_1000.rows.jsonl",
  "algorithms": [
    {"name": "uwm_speed", "type": "uwm_speed", "reweight": "deltagumbel"},
    {"name": "uwm_strength", "type": "uwm_strength", "reweight": "deltagumbel"},
    {"name": "pfr", "type": "pfr", "labeler_mode": "prefix"},
    {"name": "pfr_nowatermark", "type": "pfr_nowatermark"},
    {"name": "basic_speulative_decoding", "type": "basic_speulative_decoding"}
  ]
