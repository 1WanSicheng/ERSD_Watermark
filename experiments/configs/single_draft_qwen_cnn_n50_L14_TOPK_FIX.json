{
  "experiment": "single_draft",
  "samples": 50,
  "dataset": "cnn_dailymail",
  "max_new_tokens": 128,
  "lookaheads": [1, 4],
  "private_key": "1234",
  "target_model": "/root/PFR/ERSD_Watermark/model/Qwen2.5-7B-Instruct",
  "draft_model": "/root/PFR/ERSD_Watermark/model/Qwen2.5-0.5B-Instruct",
  "process_logits": {
    "top_k": 50,
    "top_p": 1.0,
    "temperature": 1.0
  },
  "decoders": [
    "basic_uwm",
    "pfr",
    "pfr_no_watermark"
  ],
  "metrics": {
    "aatps": true,
    "token_rate": true,
    "anlppt": {
      "variants": ["U", "Li", "PL"],
      "li_delta": 0.5,
      "pl_eps": 0.1
    }
  },
  "output": "outputs/single_draft_qwen_cnn_n50_L1-4_TOPK_FIX.json"
}
