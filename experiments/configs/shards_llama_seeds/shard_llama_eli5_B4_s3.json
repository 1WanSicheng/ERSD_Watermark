{
  "experiment": "shard_llama_eli5_n1000_B4_s3",
  "samples": 1000,
  "dataset": "eli5",
  "max_new_tokens": 128,
  "lookaheads": [
    4
  ],
  "num_drafts": [
    4
  ],
  "private_key": "1234",
  "target_model": "unsloth/Meta-Llama-3.1-8B-Instruct",
  "draft_model": "unsloth/Llama-3.2-1B-Instruct",
  "process_logits": {
    "top_k": 50,
    "top_p": 1.0,
    "temperature": 1.0
  },
  "decoders": [
    "mpfr_torchgen_cached",
    "invariant_multi"
  ],
  "metrics": {
    "aatps": true,
    "token_rate": true,
    "anlppt": {
      "variants": [
        "U",
        "Li",
        "PL"
      ],
      "li_delta": 0.5,
      "pl_eps": 0.1,
      "applies_to": [
        "mpfr_torchgen_cached",
        "invariant_multi"
      ]
    },
    "lppl": {
      "applies_to": [
        "mpfr_torchgen_cached",
        "invariant_multi"
      ]
    },
    "tpr_at_n": {
      "tokens": [
        8,
        16,
        24,
        32,
        48,
        64,
        96,
        128
      ],
      "fpr": 0.01,
      "applies_to": [
        "mpfr_torchgen_cached",
        "invariant_multi"
      ],
      "detector_per_decoder": {
        "invariant_multi": {
          "kind": "PFR",
          "labeler": "mpfr_direct"
        }
      }
    },
    "kl_ratio": {
      "applies_to": [
        "mpfr_torchgen_cached"
      ]
    }
  },
  "output": "outputs/multi/shards_llama/shard_llama_eli5_n1000_B4_s3.json",
  "seed_offset": 20000
}
