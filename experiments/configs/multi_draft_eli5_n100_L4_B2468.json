{
  "experiment": "multi_draft",
  "samples": 100,
  "dataset": "eli5",
  "max_new_tokens": 128,
  "lookaheads": [4],
  "num_drafts": [2, 4, 6, 8],
  "private_key": "1234",
  "process_logits": {
    "top_k": 50,
    "top_p": 1.0,
    "temperature": 1.0
  },
  "decoders": [
    "ms_pfr_cached",
    "mpfr_torchgen_cached",
    "invariant_multi"
  ],
  "metrics": {
    "aatps": true,
    "token_rate": true,
    "anlppt": {
      "variants": ["U", "Li", "PL"],
      "li_delta": 0.5,
      "pl_eps": 0.1,
      "applies_to": ["ms_pfr_cached", "mpfr_torchgen_cached"]
    }
  },
  "output": "outputs/multi_draft_eli5_n100_L4_B2-4-6-8.json"
}
